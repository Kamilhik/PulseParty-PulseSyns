# Standard PulseSync. Set the real HTTPS URL after deploying the shared service.
# No native host patch or companion is needed for rooms.
PULSEPARTY_RELAY_URL=
# Historical embedded mode is opt-in only, not used by the standard addon:
# PULSEPARTY_TRANSPORT=embedded
# The following values are for optional Docker hosting.
BIND_HOST=127.0.0.1
PORT=8787
MAX_PARTICIPANTS=16
MAX_ROOMS=1000
INVITE_TTL_MS=3600000
HOST_GRACE_MS=20000
ROOM_TTL_MS=3600000
# Your domain for Caddy; set a real domain before docker compose up.
PULSEPARTY_DOMAIN=
# Your Discord application; never use a Spotify/PulseSync application ID.
DISCORD_APPLICATION_ID=
DISCORD_ACTIVITY_TYPE=listening
# Optional absolute path to the built official Social SDK worker.
DISCORD_WORKER_PATH=
