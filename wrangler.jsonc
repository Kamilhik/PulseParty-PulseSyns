{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pulseparty",
  "main": "cloudflare/worker.ts",
  "compatibility_date": "2026-11-18",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": false },
  "durable_objects": { "bindings": [{ "name": "ROOMS", "class_name": "PulsePartyRooms" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["PulsePartyRooms"] }],
  "assets": { "directory": "./web", "binding": "ASSETS", "run_worker_first": true, "html_handling": "none" }
}
